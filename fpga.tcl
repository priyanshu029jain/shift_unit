# FPGA implementation of the shift units with AMD Vivado: synthesis, placement
# and routing, then utilization, timing and power reports.
#
# Usage (from any folder):
#   vivado -mode batch -nojournal -nolog -notrace -source fpga.tcl
#   vivado -mode batch -nojournal -nolog -notrace -source fpga.tcl -tclargs barrel_shifter
#   vivado -mode batch -nojournal -nolog -notrace -source fpga.tcl -tclargs all 32 5 xc7z020clg400-1
#
# Arguments (all optional, in this order):
#   module   module name or "all"                 (default: all)
#   WIDTH    data width                           (default: 16)
#   PERIOD   clock period constraint, ns          (default: 10)
#   part     Vivado part number                   (default: xc7a35tcpg236-1, Artix-7 on Basys 3)
#
# The shift units are combinational, so each one is wrapped in a register stage
# on every input and output, clocked by "clk":
#
#   in regs -> shift unit (LUTs + routing) -> out regs
#
# The worst register-to-register path then measures the unit itself, fully
# placed and routed, and the clock gives the power estimate real switching
# activity. The wrapper is implemented out of context (no I/O buffers or pins),
# since the unit is a block meant to sit inside a larger design.
#
# Outputs, per module, in <module>/fpga/:
#   <module>_<WIDTH>bit_utilization.rpt   whole design, then per hierarchy (shift unit = "dut")
#   <module>_<WIDTH>bit_timing.rpt        timing summary and the 10 worst paths
#   <module>_<WIDTH>bit_power.rpt         power estimate (vectorless), whole design and per hierarchy

set root    [file dirname [file normalize [info script]]]
set modules {logical_shift_unit circular_shift_unit arithmetic_shift_unit barrel_shifter}

proc usage {msg} {
    global modules
    puts "Error: $msg"
    puts "Usage: vivado -mode batch -nojournal -nolog -notrace -source fpga.tcl \[-tclargs \[module|all\] \[WIDTH\] \[PERIOD\] \[part\]\]"
    puts "Modules: [join $modules {, }]"
    exit 1
}

# Verilog for the register wrapper around module m
proc wrapper_verilog {m} {
    set has_mode [expr {$m eq "barrel_shifter"}]
    set mode_port [expr {$has_mode ? "\n    input  wire [1:0]         mode," : ""}]
    set mode_reg  [expr {$has_mode ? "\n    reg  [1:0]         mode_q;" : ""}]
    set mode_ff   [expr {$has_mode ? "\n        mode_q    <= mode;" : ""}]
    set mode_conn [expr {$has_mode ? "\n        .mode    (mode_q)," : ""}]
    return "// Generated by fpga.tcl: registers on every input and output of $m
module fpga_wrapper #(
    parameter WIDTH   = 16,
    parameter SHAMT_W = \$clog2(WIDTH)
) (
    input  wire               clk,
    input  wire \[WIDTH-1:0\]   data_in,
    input  wire \[SHAMT_W-1:0\] shamt,
    input  wire               dir,$mode_port
    output reg  \[WIDTH-1:0\]   data_out
);
    reg  \[WIDTH-1:0\]   data_in_q;
    reg  \[SHAMT_W-1:0\] shamt_q;
    reg                dir_q;$mode_reg
    wire \[WIDTH-1:0\]   result;

    always @(posedge clk) begin
        data_in_q <= data_in;
        shamt_q   <= shamt;
        dir_q     <= dir;$mode_ff
        data_out  <= result;
    end

    (* keep_hierarchy = \"yes\" *)
    $m #(.WIDTH(WIDTH)) dut (
        .data_in (data_in_q),
        .shamt   (shamt_q),
        .dir     (dir_q),$mode_conn
        .data_out(result)
    );
endmodule
"
}

# ---- Arguments ---------------------------------------------------------------

if {$argc > 4} { usage "too many arguments" }

set target [expr {$argc >= 1 ? [string trimright [lindex $argv 0] /] : "all"}]
set width  [expr {$argc >= 2 ? [lindex $argv 1] : 16}]
set period [expr {$argc >= 3 ? [lindex $argv 2] : 10}]
set part   [expr {$argc >= 4 ? [lindex $argv 3] : "xc7a35tcpg236-1"}]

if {$target eq "all"} {
    set targets $modules
} elseif {$target in $modules} {
    set targets [list $target]
} else {
    usage "unknown module '$target'"
}
if {![string is integer -strict $width] || $width < 2} {
    usage "WIDTH must be a number >= 2 (got '$width')"
}
if {![string is double -strict $period] || $period <= 0} {
    usage "PERIOD must be a positive number of ns (got '$period')"
}
if {[llength [get_parts -quiet $part]] != 1} {
    usage "part '$part' is not installed in this Vivado"
}

# ---- Implementation ----------------------------------------------------------

set summary {}

foreach m $targets {
    set out_dir [file join $root $m fpga]
    set base    [file join $out_dir "${m}_${width}bit"]
    file mkdir $out_dir

    # The wrapper is generated into a temporary file and removed afterwards
    set fh [file tempfile wrapper_file fpga_wrapper.v]
    puts $fh [wrapper_verilog $m]
    close $fh

    create_project -in_memory -part $part
    read_verilog [list [file join $root $m $m.v] $wrapper_file]

    synth_design -top fpga_wrapper -part $part -generic WIDTH=$width -mode out_of_context
    file delete $wrapper_file

    create_clock -name clk -period $period [get_ports clk]
    # Out of context there is no real clock buffer; assume clk comes from a
    # global buffer so clock delay and skew are still estimated.
    set_property HD.CLK_SRC BUFGCTRL_X0Y0 [get_ports clk]

    opt_design
    place_design
    route_design

    # Power in mW: in W, the shift units' dynamic power rounds to 0.001
    set_units -power mW

    report_utilization    -file "${base}_utilization.rpt"
    report_utilization    -file "${base}_utilization.rpt" -append -hierarchical
    report_timing_summary -file "${base}_timing.rpt" -max_paths 10
    report_power          -file "${base}_power.rpt" -hierarchical_depth 2

    # ---- Summary numbers
    set path      [get_timing_paths -setup -max_paths 1 -nworst 1]
    set slack     [get_property SLACK $path]
    set fmax      [expr {1000.0 / ($period - $slack)}]
    set data      [get_property DATAPATH_DELAY $path]
    set logic     [get_property DATAPATH_LOGIC_DELAY $path]
    set levels    [get_property LOGIC_LEVELS $path]
    set from      [get_property PARENT_CELL [get_property STARTPOINT_PIN $path]]
    set to        [get_property PARENT_CELL [get_property ENDPOINT_PIN $path]]
    set hold      [get_property SLACK [get_timing_paths -hold -max_paths 1 -nworst 1]]

    # Resources used by the shift unit alone (not the wrapper registers), as
    # Vivado counts them: "Slice LUTs" includes LUT combining, so two small LUT
    # cells packed into one LUT6 count once.
    set util  [report_utilization -cells [get_cells dut] -return_string]
    set luts 0; set f7 0; set f8 0
    regexp {\|\s*Slice LUTs\*?\s*\|\s*(\d+)} $util -> luts
    regexp {\|\s*F7 Muxes\*?\s*\|\s*(\d+)}   $util -> f7
    regexp {\|\s*F8 Muxes\*?\s*\|\s*(\d+)}   $util -> f8
    set muxfs [expr {$f7 + $f8}]
    set regs  [llength [get_cells -quiet -hierarchical -filter {PRIMITIVE_GROUP == FLOP_LATCH}]]

    set pwr_rpt [report_power -return_string]
    set p_total "?"
    set p_dyn   "?"
    regexp {Total On-Chip Power \(mW\)\s*\|\s*(\S+)} $pwr_rpt -> p_total
    regexp {Dynamic \(mW\)\s*\|\s*(\S+)}             $pwr_rpt -> p_dyn

    set status [expr {$slack >= 0 && $hold >= 0 ? "MET" : "VIOLATED"}]

    lappend summary [list $m $luts $muxfs $regs $data $logic $levels $fmax $slack $hold $status $p_dyn $p_total "$from -> $to"]

    close_project
}

# ---- Summary -----------------------------------------------------------------

puts ""
puts "Vivado [version -short], part $part, WIDTH = $width, PERIOD = $period ns, out of context"
puts ""
puts [format "%-22s %5s %5s %4s %9s %10s %6s %10s %8s %8s %9s %8s %10s  %s" \
        "Module" "LUTs" "MUXF" "FFs" "Path (ns)" "Logic (ns)" "Levels" "Fmax (MHz)" "Setup" "Hold" "Timing" "Dyn (mW)" "Total (mW)" "Critical path"]
puts [string repeat - 150]
set violated 0
foreach row $summary {
    lassign $row m luts muxfs regs data logic levels fmax slack hold status p_dyn p_total path
    puts [format "%-22s %5d %5d %4d %9.3f %10.3f %6d %10.1f %8.3f %8.3f %9s %8s %10s  %s" \
            $m $luts $muxfs $regs $data $logic $levels $fmax $slack $hold $status $p_dyn $p_total $path]
    if {$status ne "MET"} { incr violated }
}
puts ""
puts "LUTs (Slice LUTs, after LUT combining) and MUXF (F7 + F8) = used by the shift unit; FFs = wrapper registers."
puts "Path = worst register-to-register delay (clock-to-Q + logic + routing); Logic = the part in cells."
puts "Levels = LUT/MUXF levels on that path; Setup/Hold = worst slack (ns) at PERIOD."
puts "Power is a vectorless estimate for the whole wrapper; Total includes the device's static power."
puts "Full reports: <module>/fpga/"

if {$violated} {
    puts "Error: $violated module(s) miss timing at PERIOD = $period ns"
    exit 1
}
